{
  "name": "dsh-hardware-monitor",
  "version": "2.0.0",
  "description": "DSH 插件：把本机 Hardware Monitor 接入 dsh —— 侧边栏完整面板 + 输入框下方性能挂件 + hardware_monitor_status 工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tyvtjhj/system-resource-monitor.git"
  },
  "homepage": "https://github.com/tyvtjhj/system-resource-monitor",
  "author": "tyvtjhj",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "hardware-monitor",
    "system-monitor",
    "windows"
  ],
  "files": [
    "client.js",
    "lib/",
    "cordis.patch.yml",
    "adapter.config.json",
    "inject.js",
    "install.ps1",
    "uninstall.ps1",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "assets/icon-180.png"
  ]
}
