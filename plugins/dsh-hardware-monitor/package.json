{
  "name": "dsh-hardware-monitor",
  "version": "1.1.6",
  "private": true,
  "description": "DSH 插件：把本机 Hardware Monitor 接入 dsh —— 侧边栏完整面板 + 输入框下方性能挂件 + hardware_monitor_status 工具",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
