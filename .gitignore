# Python 虚拟环境与缓存
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
pytest-of-*/
.ruff_cache/

# 可选适配器的 Node 工具链
node_modules/
plugin/adapters/vscode/out/
*.vsix

# 环境变量与本机配置（.env.example 会提交）
.env

# 系统缩略文件
Thumbs.db
.DS_Store

# 锁脚本临时文件（生成中断时可能残留；正常结束由脚本清理）
requirements*.txt.tmp*

# DSH 插件加载日志（运行时生成）
plugin/adapters/dsh/apply.log

# 本地验证临时目录（服务日志、无头浏览器 profile 等）
.tmp/
plugin/adapters/dsh/service.log
