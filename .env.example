# hardware-monitor environment variables (example file).
#
# This file is NOT loaded automatically by the application. Export the values
# in your shell, put them in a launcher script, or configure them in your IDE:
#   Windows PowerShell : $env:MONITOR_PORT = '5679'
#   Linux / macOS      : export MONITOR_PORT=5679
#
# Copy the lines you need into your own .env / launcher; do not commit real tokens.

# Listen address. 0.0.0.0 = reachable from the LAN, 127.0.0.1 = local only.
MONITOR_HOST=0.0.0.0

# Listen port. Also used by scripts/doctor.py to probe the service.
MONITOR_PORT=5678

# Optional API token. When non-empty every /api/* request needs
# "X-Monitor-Token: <token>", or the page opened with ?token=<token>.
MONITOR_TOKEN=

# Access-Control-Allow-Origin value for API responses.
MONITOR_CORS_ORIGIN=*

# Allowed frame parents for the /widget page (CSP frame-ancestors).
# Used by the plugin/widget feature planned in task T4.
MONITOR_FRAME_ANCESTORS='self' http://127.0.0.1:* http://localhost:*
